# =====================================================
#  ShopPay — Payment Integration Demo · Env Template
#  Copy this file to .env and fill in the values.
# =====================================================

# ─── Stripe ────────────────────────────────────────────
# Get these from https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=sk_test_xxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxx
NUXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxxxx

# Stripe Price IDs per plan × interval.
# Create Products + recurring Prices in the Stripe Dashboard,
# then paste each price_xxx ID below.
# If a value is empty, the app will use the demo gateway simulator for that plan.
STRIPE_PRICE_STARTER_MONTHLY=
STRIPE_PRICE_STARTER_YEARLY=
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_YEARLY=
STRIPE_PRICE_ENTERPRISE_MONTHLY=
STRIPE_PRICE_ENTERPRISE_YEARLY=

# ─── PayPal ────────────────────────────────────────────
NUXT_PUBLIC_PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
PAYPAL_MODE=sandbox

# PayPal Subscription Plan IDs per plan × interval.
# Create Catalog Products + Billing Plans via the PayPal REST API,
# then paste each P-XXXX plan ID here.
PAYPAL_PLAN_STARTER_MONTHLY=
PAYPAL_PLAN_STARTER_YEARLY=
PAYPAL_PLAN_PRO_MONTHLY=
PAYPAL_PLAN_PRO_YEARLY=
PAYPAL_PLAN_ENTERPRISE_MONTHLY=
PAYPAL_PLAN_ENTERPRISE_YEARLY=

# ─── App ───────────────────────────────────────────────
NUXT_PUBLIC_BASE_URL=http://localhost:3000
STRIPE_LINK_EXPIRE_MINUTES=30

# ─── Mail (SMTP) ───────────────────────────────────────
APP_MAIL_SECURE=false
APP_MAIL_HOST=sandbox.smtp.mailtrap.io
APP_MAIL_PORT=2525
APP_MAIL_USER=
APP_MAIL_PASSWORD=
